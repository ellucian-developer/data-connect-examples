{
  "name": "apply-batch-posting-codes-to-student-records-rorbpst",
  "description": "Processes the Batch Posting Codes generated by ROPPCAT and applies the appropriate updates to student records",
  "parameters": [
    {
      "name": "ethosApiKey",
      "type": "string",
      "required": true,
      "sensitive": true,
      "persistent": true
    }
  ],
  "pipeline": [
    "Execute RORBPST Banner Job",
    "For Each",
    "Write lis File For Preview"
  ],
  "segments": {
    "Execute RORBPST Banner Job": {
      "class": "ExecuteBannerJob",
      "config": {
        "name": "RORBPST",
        "outputFileName": "{{jobName}}_{{jobNumber}}.lis",
        "ignoreErrors": false,
        "parameters": [
          {
            "type": "character",
            "value": "2627",
            "number": "01",
            "required": true,
            "parameter": "Aid Year Code",
            "multiValue": false
          },
          {
            "type": "character",
            "value": "Y",
            "number": "02",
            "required": false,
            "parameter": "Print Report (Y/N)",
            "multiValue": false
          }
        ]
      }
    },
    "For Each": {
      "class": "forEach"
    },
    "Write lis File For Preview": {
      "class": "s3sink",
      "config": {
        "key": "RORBPST_{{message.header.bannerJobNumber}}.lis",
        "addNewlineAfterEachMessage": true,
        "includeTotalCount": false,
        "generatePresignedUrl": false,
        "utfEncoding": "utf-8",
        "writeImmediately": false
      }
    }
  }
}
